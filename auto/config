#!/bin/sh
set -e

case "${ARCH:-amd64}" in
    arm64) bootloaders="grub-efi" ;;
    *) bootloaders="syslinux,grub-efi" ;;
esac

lb config noauto \
    --mode debian \
    --distribution trixie \
    --architecture "${ARCH:-amd64}" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --debian-installer none \
    --binary-images iso-hybrid \
    --bootloaders "$bootloaders" \
    --iso-application "FuzeOS" \
    --iso-publisher "FuzeOS" \
    --iso-volume "FuzeOS" \
    --image-name fuzeos \
    --bootappend-live "boot=live components quiet splash hostname=fuzecorp username=didier user-fullname=Didier locales=fr_FR.UTF-8 keyboard-layouts=fr timezone=Europe/Paris" \
    "${@}"
